NODE_ENV=production
API_DOCS_ENABLED=false
PORT=3000
APP_BRAND_NAME=幻乐灵玑笔记
CORS_ORIGINS=https://admin.hyljzn.cn

JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_another_32_random_characters
ACCESS_TOKEN_EXPIRES_IN=15m
# 管理后台访问令牌有效期；后台还会使用刷新令牌静默续签。
ADMIN_ACCESS_TOKEN_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=30d
WITHDRAW_DATA_SECRET=replace_with_at_least_32_random_characters

# Taku 服务端激励回调的签名密钥，不是 Android SDK App Key。
TAKU_CALLBACK_SECRET=
# Key ID 到容器内私钥路径的 JSON 映射；私钥文件放在 CERT_ROOT 对应的宿主机目录。
# 示例：'{"123":"/app/certs/taku-ecpm-server.pem"}'，请替换真实 Key ID 和文件名。
TAKU_ECPM_PRIVATE_KEY_FILES_JSON=

ALIPAY_APP_ID=replace_with_alipay_app_id
# 私钥换行写成字面量 \n，避免 env 文件出现多行值。
ALIPAY_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace_me\n-----END PRIVATE KEY-----
ALIPAY_APP_CERT_PATH=certs/appCertPublicKey.crt
ALIPAY_PUBLIC_CERT_PATH=certs/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=certs/alipayRootCert.crt
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_ENDPOINT=https://openapi.alipay.com
# 必须与支付宝开放平台审核通过的转账场景名称完全一致。
ALIPAY_TRANSFER_SCENE_NAME=现金营销

# 阿里云短信验证码；签名须处于“可用-正常”，模板变量名必须为 code。
ALIBABA_CLOUD_ACCESS_KEY_ID=replace_with_ram_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=replace_with_ram_access_key_secret
ALIYUN_SMS_SIGN_NAME=replace_with_approved_sms_sign
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=SMS_XXXXXXXXX
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5

UPLOAD_DIRECTORY=/app/uploads
UPLOAD_MAX_IMAGE_MB=5
