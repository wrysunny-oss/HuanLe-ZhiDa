NODE_ENV=development
API_DOCS_ENABLED=true
PORT=3000
APP_BRAND_NAME=幻乐智答
DATABASE_URL="mysql://root:password@127.0.0.1:3306/huanle_zhida"
JWT_ACCESS_SECRET="replace-with-at-least-32-random-characters"
JWT_REFRESH_SECRET="replace-with-another-32-random-characters"
WITHDRAW_DATA_SECRET="replace-with-withdraw-data-secret-32-chars"
ACCESS_TOKEN_EXPIRES_IN=15m
# 管理后台访问令牌有效期；后台还会使用刷新令牌静默续签。
ADMIN_ACCESS_TOKEN_EXPIRES_IN=24h
REFRESH_TOKEN_EXPIRES_IN=30d
CORS_ORIGINS=http://localhost:5173,http://localhost:5174
ADMIN_INITIAL_PASSWORD=ChangeMe123!
TAKU_CALLBACK_SECRET=
# 配置后启用 Taku 加密人民币 eCPM 动态结算，例如：{"123":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----"}
TAKU_ECPM_PRIVATE_KEYS_JSON=
# 推荐把私钥保存为未入库的 PEM 文件：{"123":"certs/taku-ecpm-123.pem"}
TAKU_ECPM_PRIVATE_KEY_FILES_JSON=
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=""
ALIPAY_APP_CERT_PATH=certs/appCertPublicKey.crt
ALIPAY_PUBLIC_CERT_PATH=certs/alipayCertPublicKey_RSA2.crt
ALIPAY_ROOT_CERT_PATH=certs/alipayRootCert.crt
ALIPAY_KEY_TYPE=PKCS8
ALIPAY_ENDPOINT=https://openapi.alipay.com
# 必须与支付宝商家平台“资金管理 - 转账场景”中已申报通过的名称一致
ALIPAY_TRANSFER_SCENE_NAME=现金营销
# 阿里云短信：使用已审核通过的签名和验证码模板，模板变量名需为 code
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_REGISTER_TEMPLATE_CODE=
SMS_CODE_TTL_SECONDS=300
SMS_CODE_RESEND_SECONDS=60
SMS_CODE_MAX_ATTEMPTS=5
UPLOAD_DIRECTORY=uploads
UPLOAD_MAX_IMAGE_MB=5
